<?php
// ============================================================
// Configuracion de correo transaccional
// ============================================================
// 1. Copia este archivo como mail.php en la misma carpeta:
//    cp mail.php.example mail.php
//
// 2. Ajusta los valores segun tu entorno.
//
// Si no creas mail.php, el sistema funciona igual en modo 'log':
// cada correo queda registrado en logs/emails.log y en la tabla
// correos_log, sin salir del servidor. Ideal para desarrollo.
// ============================================================

// Interruptor general. Si es false no se registra ni se envia nada.
define('MAIL_ENABLED', true);

// 'log'  -> solo registra (por defecto en XAMPP, no necesita nada mas)
// 'smtp' -> registra y ademas envia de verdad por SMTP
define('MAIL_TRANSPORT', 'log');

// ---------- Parametros SMTP (solo si MAIL_TRANSPORT = 'smtp') ----------
//
// Mailtrap (recomendado para probar en local, no entrega a buzones reales):
//   MAIL_HOST 'sandbox.smtp.mailtrap.io', MAIL_PORT 2525, MAIL_SECURE 'tls'
//   MAIL_USER y MAIL_PASS los da el panel de Mailtrap.
//
// Gmail (entrega real, requiere verificacion en dos pasos y
// una "contrasena de aplicacion", NO la contrasena de la cuenta):
//   MAIL_HOST 'smtp.gmail.com', MAIL_PORT 587, MAIL_SECURE 'tls'
//   MAIL_USER tu correo, MAIL_PASS la contrasena de aplicacion.
//
define('MAIL_HOST', 'sandbox.smtp.mailtrap.io');
define('MAIL_PORT', 2525);
define('MAIL_SECURE', 'tls');   // 'tls' (STARTTLS), 'ssl' (implicito) o '' (sin cifrado)
define('MAIL_USER', '');
define('MAIL_PASS', '');
define('MAIL_TIMEOUT', 15);     // segundos

// ---------- Remitente ----------
define('MAIL_FROM', 'no-reply@hanulbeauty.co');
define('MAIL_FROM_NAME', 'Hanul Beauty');
define('MAIL_REPLY_TO', 'soporte@hanulbeauty.co');

// ---------- URL base de la aplicacion ----------
// Se usa para construir los enlaces de los correos.
define('APP_BASE_URL', 'http://localhost/Proyecto_Estetica');
